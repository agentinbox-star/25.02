{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentInbox",
  "colors": {
    "primary": "#3B82F6",
    "light": "#60A5FA",
    "dark": "#1E40AF"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Гайды",
        "groups": [
          {
            "group": "Начало работы",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Настройка",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Содержание и примеры",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "AI инструменты",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API справочник",
        "groups": [
          {
            "group": "API документация",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Примеры endpoints",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Документация",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Блог",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Поддержка",
        "href": "mailto:support@agentinbox.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Панель управления",
      "href": "https://app.agentinbox.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/agentinbox",
      "github": "https://github.com/agentinbox",
      "linkedin": "https://linkedin.com/company/agentinbox"
    }
  }
}
